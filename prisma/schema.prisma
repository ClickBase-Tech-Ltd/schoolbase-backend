model EmailLog {
  id             String      @id @default(cuid())
  schoolId       String?
  school         School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientName  String?
  emailType      EmailType
  subject        String
  sentAt         DateTime    @default(now())
  status         EmailStatus @default(SENT)
  error          String?
  messageId      String?
  metadata       String?     @db.LongText
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([schoolId], map: "EmailLog_schoolId_fkey")
  @@index([emailType])
  @@index([sentAt])
}

model AccountCategory {
  id              String @id @default(cuid())
  schoolId        String
  school          School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type            TransactionType
  name            String
  description     String?
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    FinancialTransaction[]

  @@unique([schoolId, type, name])
  @@index([schoolId])
  @@index([type])
}

model AccountingAccount {
  id               String                  @id @default(cuid())
  schoolId          String
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code             String
  name             String
  type             AccountingAccountType
  description      String?
  isActive         Boolean                 @default(true)
  parentAccountId  String?
  parentAccount    AccountingAccount?      @relation("AccountingAccountParent", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts    AccountingAccount[]     @relation("AccountingAccountParent")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  journalLines     AccountingJournalLine[]
  bankStatementImports BankStatementImport[]

  @@unique([schoolId, code])
  @@index([schoolId, type])
}

model AccountingJournalEntry {
  id              String                    @id @default(cuid())
  schoolId        String
  school          School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reference       String
  description     String?
  entryDate       DateTime
  status          AccountingJournalStatus   @default(DRAFT)
  sourceType      String?
  sourceId        String?
  idempotencyKey  String?                   @db.VarChar(191)
  createdBy       String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  postedAt        DateTime?
  lines           AccountingJournalLine[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, entryDate])
}

model AccountingPeriod {
  id                    String                  @id @default(cuid())
  schoolId              String
  school                School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                  String
  startDate             DateTime
  endDate               DateTime
  status                AccountingPeriodStatus  @default(OPEN)
  ledgerBalanceMinor    Int                     @default(0)
  bankStatementMinor    Int                     @default(0)
  differenceMinor       Int                     @default(0)
  totalDebitMinor       Int                     @default(0)
  totalCreditMinor      Int                     @default(0)
  isBankReconciled      Boolean                 @default(false)
  hasOpenEntries        Boolean                 @default(false)
  closedAt              DateTime?
  closedBy              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model AccountingJournalLine {
  id            String                 @id @default(cuid())
  journalEntryId String
  journalEntry  AccountingJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId     String
  account       AccountingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  side          AccountingJournalLineSide
  amount        Int
  description   String?
  createdAt     DateTime               @default(now())
  bankStatementMatches BankStatementMatch[]

  @@index([journalEntryId])
  @@index([accountId])
}

model BankStatementImport {
  id                String                     @id @default(cuid())
  schoolId          String
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  accountingAccountId String
  accountingAccount AccountingAccount          @relation(fields: [accountingAccountId], references: [id], onDelete: Restrict)
  periodStart       DateTime
  periodEnd         DateTime
  openingBalanceMinor Int
  closingBalanceMinor Int
  fileName          String
  checksum          String                     @db.Char(64)
  status            BankStatementImportStatus  @default(IMPORTED)
  importedBy        String
  importedAt        DateTime                   @default(now())
  reconciledBy      String?
  reconciledAt      DateTime?
  preparedBy        String?
  preparedAt        DateTime?
  lines             BankStatementLine[]
  events            BankStatementReconciliationEvent[]

  @@index([schoolId, accountingAccountId, checksum])
  @@index([schoolId, periodStart, periodEnd])
  @@index([accountingAccountId, status])
}

model BankStatementReconciliationEvent {
  id        String                           @id @default(cuid())
  schoolId  String
  school    School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  importId  String
  statementImport BankStatementImport        @relation(fields: [importId], references: [id], onDelete: Cascade)
  actorId   String
  action    BankStatementReconciliationAction
  reason    String?                          @db.LongText
  metadata  String?                          @db.LongText
  createdAt DateTime                         @default(now())

  @@index([schoolId, importId, createdAt])
  @@index([actorId, createdAt])
}

model BankStatementLine {
  id                    String                 @id @default(cuid())
  importId              String
  statementImport       BankStatementImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  transactionDate       DateTime
  description           String
  reference             String?
  direction             BankStatementDirection
  amountMinor           Int
  createdAt             DateTime               @default(now())
  matches               BankStatementMatch[]

  @@index([importId, transactionDate])
}

model BankStatementMatch {
  id               String              @id @default(cuid())
  statementLineId  String
  statementLine    BankStatementLine   @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  journalLineId    String
  journalLine      AccountingJournalLine @relation(fields: [journalLineId], references: [id], onDelete: Restrict)
  amountMinor      Int
  matchedBy        String
  matchedAt        DateTime            @default(now())

  @@unique([statementLineId, journalLineId])
  @@index([journalLineId])
}

model FinancialTransaction {
  id                String            @id @default(cuid())
  schoolId          String
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId        String
  category          AccountCategory   @relation(fields: [categoryId], references: [id])
  type              TransactionType
  amount            Int
  currency          String            @default("NGN")
  paymentMethod     PaymentMethod?
  description       String?
  referenceNumber   String?
  invoiceId         String?
  invoice           Invoice?          @relation("InvoiceAccountingTransactions", fields: [invoiceId], references: [id])
  invoiceItemId     String?
  invoiceItem       InvoiceItem?      @relation("InvoiceItemAccountingTransactions", fields: [invoiceItemId], references: [id])
  paymentId         String?           @unique
  payment           Payment?          @relation("PaymentAccountingTransactions", fields: [paymentId], references: [id])
  transactionDate   DateTime
  status            TransactionStatus @default(DRAFT)
  createdBy         String
  createdByUser     User              @relation("FinancialTransactionCreatedBy", fields: [createdBy], references: [id])
  postedAt          DateTime?
  postedBy          String?
  postedByUser      User?             @relation("FinancialTransactionPostedBy", fields: [postedBy], references: [id])
  reversalDate      DateTime?
  reversalReason    String?
  reversedBy        String?
  reversedByUser    User?             @relation("FinancialTransactionReversedBy", fields: [reversedBy], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  auditLogs         FinancialAuditLog[]

  @@index([schoolId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([transactionDate])
  @@index([schoolId, invoiceId])
  @@index([invoiceItemId])
}

model FinancialAuditLog {
  id                  String @id @default(cuid())
  schoolId            String
  school              School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactionId       String
  transaction         FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action              String
  previousValues      String? @db.LongText
  newValues           String? @db.LongText
  changedBy           String
  changedByUser       User   @relation(fields: [changedBy], references: [id])
  createdAt           DateTime @default(now())

  @@index([schoolId])
  @@index([transactionId])
}

model CashbookExportAudit {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  filters    String   @db.LongText
  rowCount   Int
  exportedAt DateTime @default(now())

  @@index([schoolId, exportedAt])
  @@index([actorId, exportedAt])
}
