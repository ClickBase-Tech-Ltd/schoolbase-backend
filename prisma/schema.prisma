model IdCardOrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventType String
  actorId   String?
  details   String?  @db.LongText
  createdAt DateTime @default(now())
  order     IdCardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

