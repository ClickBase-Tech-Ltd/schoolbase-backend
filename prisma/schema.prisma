  reason      String?  @db.Text
  createdAt   DateTime @default(now())
  award       IdCardUsageAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  order       IdCardOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

