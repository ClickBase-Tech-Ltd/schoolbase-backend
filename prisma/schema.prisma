  @@index([expiresAt])
}

model IdCardOrder {
  id                       String   @id @default(cuid())
  schoolId                 String
  quoteId                  String   @unique
  status                   String   @default("PAYMENT_PENDING")
  paymentStatus            String   @default("PENDING")
