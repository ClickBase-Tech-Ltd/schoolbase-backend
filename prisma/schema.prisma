  pupil          Pupil           @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  order          IdCardOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supersedes     IdCardIssuance? @relation("IdCardReplacement", fields: [supersedesId], references: [id], onDelete: SetNull)
  replacements   IdCardIssuance[] @relation("IdCardReplacement")

  @@unique([orderId, pupilId])
