  @@index([orderId])
}

model PlatformSupportRequest {
  id        String                   @id @default(cuid())
  schoolId  String?
  subject   String
  message   String                   @db.LongText
  status    SupportStatus            @default(OPEN)
  priority  SupportPriority          @default(MEDIUM)
  response  String?                  @db.LongText
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  school    School?                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  messages  PlatformSupportMessage[]

  @@index([schoolId], map: "PlatformSupportRequest_schoolId_fkey")
}

model PlatformSupportMessage {
  id             String                   @id @default(cuid())
  requestId      String
  senderRole     SupportMessageSenderRole @default(SCHOOL)
  senderName     String
  senderEmail    String?
  body           String                   @db.LongText
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  supportRequest PlatformSupportRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId], map: "PlatformSupportMessage_requestId_fkey")
}

enum AdvertiserVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AdPlacementType {
  LOGIN_PAGE_BANNER
  PUBLIC_PARTNER_STRIP
  RESOURCE_SPONSOR
  PARENT_LOGIN_BANNER
  RESULTS_CHECKER_SPONSOR
  SIGNUP_PARTNER_STRIP
}

enum AdCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LIVE
  PAUSED
  EXPIRED
}

enum AdAnalyticsEventType {
  IMPRESSION
  CLICK
}

model Advertiser {
  id                  String                       @id @default(cuid())
  companyName         String
  contactName         String
  email               String
  phone               String?
  website             String?
  category            String?
  verificationStatus  AdvertiserVerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  rejectionReason     String?                      @db.Text
  notes               String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  campaigns           AdCampaign[]
  competitionSponsor  CompetitionSponsor?

  @@index([verificationStatus])
}

model AdPlacement {
  id            String         @id @default(cuid())
  name          String
  type          AdPlacementType @unique
  path          String?
  label         String         @default("Sponsored")
  enabled       Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaigns     AdCampaignPlacement[]

  @@index([enabled, sortOrder])
}

model AdCampaign {
  id                 String                @id @default(cuid())
  advertiserId       String
  title              String
  slug               String               @unique
  headline           String?
  summary            String?              @db.Text
  landingUrl         String
  status             AdCampaignStatus      @default(DRAFT)
  startDate          DateTime?
  endDate            DateTime?
  budget             Float                @default(0)
  currency           String               @default("NGN")
  enabled            Boolean              @default(true)
  approvedBy         String?
  approvedAt         DateTime?
  rejectedReason     String?              @db.Text
  submittedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  advertiser         Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  placements         AdCampaignPlacement[]
  creatives          AdCreative[]
  approvalLogs       CampaignApprovalLog[]
  analyticsEvents    AdAnalyticsEvent[]

  @@index([advertiserId])
  @@index([status])
  @@index([startDate, endDate])
}

model AdCampaignPlacement {
  id          String      @id @default(cuid())
  campaignId  String
  placementId String
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placementId])
  @@index([placementId])
}

model AdCreative {
  id            String      @id @default(cuid())
  campaignId    String
  imageUrl      String?
  headline      String?
  description   String?     @db.Text
  ctaText       String?     @default("Learn more")
  altText       String?
  assetType     String      @default("IMAGE")
  isPrimary     Boolean     @default(true)
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  campaign      AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignApprovalLog {
  id          String      @id @default(cuid())
  campaignId  String
  reviewerId  String?
  action      String
  reason      String?     @db.Text
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model AdAnalyticsEvent {
  id             String               @id @default(cuid())
  campaignId     String
  placementId    String?
  eventType      AdAnalyticsEventType
  sourcePath     String?
  userAgent      String?
  referrer       String?
  ipHash         String?
  createdAt      DateTime             @default(now())
  campaign       AdCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, eventType])
  @@index([sourcePath])
}

model Subject {
  id                   String                @id @default(cuid())
  schoolId             String
  name                 String
  code                 String?
  createdAt            DateTime              @default(now())
  results              Result[]
  historicalTermTotals HistoricalTermTotal[]
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectClasses       SubjectClass[]
  subjectResults       SubjectResult[]
  teacherSubjects      TeacherSubject[]
  timetableEntries     TimetableEntry[]
  competitionCategories CompetitionCategory[]
  competitionQuestionSets CompetitionQuestionSet[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherClass {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  classId   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@index([classId], map: "TeacherClass_classId_fkey")
  @@index([schoolId], map: "TeacherClass_schoolId_fkey")
}

model TeacherSubject {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId], map: "TeacherSubject_schoolId_fkey")
  @@index([subjectId], map: "TeacherSubject_subjectId_fkey")
}

model SubjectClass {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId], map: "SubjectClass_schoolId_fkey")
  @@index([subjectId], map: "SubjectClass_subjectId_fkey")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  schoolId  String
  classId   String
  pupilId   String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  pupil     Pupil            @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([pupilId, date])
  @@index([classId], map: "AttendanceRecord_classId_fkey")
  @@index([schoolId], map: "AttendanceRecord_schoolId_fkey")
}

model PaymentAccount {
  id            String   @id @default(cuid())
  schoolId      String
  label         String
  bankName      String
  accountName   String
  accountNumber String
  branchName    String?
  currency      String?
  purpose       String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive, sortOrder])
  @@index([schoolId, isDefault])
}

model FeeSchedule {
  id        String    @id @default(cuid())
  schoolId  String
  termId    String
  classId   String?
  name      String
  amount    Int
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  items     FeeScheduleItem[]
  invoices  Invoice[]

  @@index([schoolId], map: "FeeSchedule_schoolId_fkey")
  @@index([termId], map: "FeeSchedule_termId_fkey")
  @@index([classId], map: "FeeSchedule_classId_fkey")
}

model FeeScheduleItem {
  id            String    @id @default(cuid())
  schoolId      String
  feeScheduleId String
  name          String
  amount        Int
  isRequired    Boolean   @default(true)
  sortOrder     Int       @default(0)
  description   String?
  createdAt     DateTime  @default(now())

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeSchedule  FeeSchedule        @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  adjustments  StudentFeeAdjustment[]

  @@index([feeScheduleId])
  @@index([schoolId])
}

model Invoice {
  id                 String        @id @default(cuid())
  schoolId           String
  pupilId            String
  feeScheduleId      String
  invoiceNo          String
  amountDue          Int
  amountPaid         Int           @default(0)
  status             InvoiceStatus @default(DRAFT)
  parentMarkedPaid   Boolean       @default(false)
  parentMarkedPaidAt DateTime?
  dueDate            DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  feeSchedule        FeeSchedule   @relation(fields: [feeScheduleId], references: [id])
  pupil              Pupil         @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  school             School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items              InvoiceItem[]
  adjustments        StudentFeeAdjustment[]
  payments           Payment[]
  accountingTransactions FinancialTransaction[] @relation("InvoiceAccountingTransactions")

  @@unique([schoolId, invoiceNo])
  @@index([feeScheduleId], map: "Invoice_feeScheduleId_fkey")
  @@index([pupilId], map: "Invoice_pupilId_fkey")
}

model InvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  feeScheduleItemId String?
  name              String
  amount            Int
  quantity          Int      @default(1)
  description       String?
  createdAt         DateTime @default(now())

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeScheduleItem FeeScheduleItem? @relation(fields: [feeScheduleItemId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  accountingTransactions FinancialTransaction[] @relation("InvoiceItemAccountingTransactions")

  @@index([invoiceId])
  @@index([feeScheduleItemId])
}

model StudentFeeAdjustment {
  id                String            @id @default(cuid())
  schoolId          String
  studentId         String
  invoiceId         String?
  feeScheduleItemId String?
  adjustmentType    FeeAdjustmentType
  amount            Int?
  percentage        Float?
  reason            String?
  status            AdjustmentStatus  @default(ACTIVE)
  approvedBy        String?
  createdAt         DateTime          @default(now())

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Pupil           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeScheduleItem FeeScheduleItem? @relation(fields: [feeScheduleItemId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId])
  @@index([invoiceId])
  @@index([feeScheduleItemId])
}

enum FeeAdjustmentType {
  SCHOLARSHIP
  DISCOUNT
  WAIVER
  BURSARY
  EXEMPTION
}

enum AdjustmentStatus {
  ACTIVE
  APPROVED
  REJECTED
  EXPIRED
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String?
  amount        Int
  method        PaymentMethod
  reference     String?
  idempotencyKey String?      @db.VarChar(191)
  paidAt        DateTime      @default(now())
  recordedBy    String?
  note          String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  allocations   PaymentAllocation[]
  accountingTransactions FinancialTransaction[] @relation("PaymentAccountingTransactions")

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId], map: "Payment_invoiceId_fkey")
  @@index([idempotencyKey])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  invoiceItemId String
  amount        Int
  createdAt     DateTime    @default(now())

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceItemId])
  @@index([paymentId])
  @@index([invoiceItemId])
}

model PlatformPayment {
  id         String        @id @default(cuid())
  amount     Int
  method     PaymentMethod
  reference  String?
  createdAt  DateTime      @default(now())
  recordedBy String?
  note       String?   @db.Text
}

model Assessment {
  id            String                @id @default(cuid())
  schoolId      String
  termId        String
  classId       String?
  name          String
  phase         SchoolPhase
  status        ResultStatus          @default(DRAFT)
  componentData String?               @db.LongText // JSON: { components: [{ id, name, maxScore, weight, sortOrder }] }
  description   String?               @db.Text
  dueDate       DateTime?
  createdBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term          Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  class         Class?                @relation(fields: [classId], references: [id], onDelete: SetNull)
  resultSheets  ResultSheet[]         @relation("AssessmentToSheet")
  results       Result[]
  components    AssessmentComponent[]

  @@index([schoolId], map: "Assessment_schoolId_fkey")
  @@index([termId], map: "Assessment_termId_fkey")
  @@index([classId], map: "Assessment_classId_fkey")
  @@index([schoolId, termId, status])
}

model AssessmentComponent {
  id            String                  @id @default(cuid())
  schoolId      String
  assessmentId  String
  name          String
  componentType AssessmentComponentType
  maxScore      Int
  weight        Float
  sortOrder     Int
  isOptional    Boolean                 @default(false)
  createdAt     DateTime                @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, name])
  @@index([schoolId])
  @@index([assessmentId])
}

model AssessmentTemplate {
  id               String   @id @default(cuid())
  schoolId         String
  name             String
  description      String?
  applicablePhases String   @db.LongText
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Result {
  id              String        @id @default(cuid())
  assessmentId    String
  pupilId         String
  subject         String?
  caScore         Float?
  testScore       Float?
  examScore       Float?
  grade           String?
  position        Int?
  comment         String?
  publishedAt     DateTime?
  subjectId       String?
  classId         String?
  createdAt       DateTime      @default(now())
  totalScore      Float?
  updatedAt       DateTime      @default(now()) @updatedAt
  updatedBy       String?
  deletedAt       DateTime?
  scores          String?       @db.LongText // JSON: { "ca": 10, "test": 35, "exam": 45 }
  feedback        String?       @db.LongText
  teacherRemark   String?       @db.Text
  principalRemark String?       @db.Text
  classPosition   Int?
  subjectPosition Int?
  lockedAt        DateTime?
  lockedBy        String?
  assessment      Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  pupil           Pupil         @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  class           Class?        @relation(fields: [classId], references: [id])
  subjectRef      Subject?      @relation(fields: [subjectId], references: [id])
  audits          ResultAudit[] @relation("ResultToAudit")

  @@unique([assessmentId, pupilId, subject])
  @@index([pupilId], map: "Result_pupilId_fkey")
  @@index([subjectId], map: "Result_subjectId_fkey")
  @@index([classId], map: "Result_classId_fkey")
  @@index([publishedAt])
}

model SubjectResult {
  id             String @id @default(cuid())
  schoolId       String
  classId        String
  pupilId        String
  subjectId      String
  termId         String
  academicYearId String

  totalScore     Float
  averageScore   Float
  grade          String?
  position       Int?
  teacherRemarks String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pupil   Pupil   @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([pupilId, subjectId, termId])
  @@index([classId, termId])
  @@index([pupilId, termId])
  @@index([position])
}

model ResultSheet {
  id             String @id @default(cuid())
  schoolId       String
  classId        String
  termId         String
  academicYearId String

  status ResultStatus @default(DRAFT)

  submittedBy String?
  submittedAt DateTime?

  classTeacherComments   String?   @db.Text
