generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Partner {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  primaryColor   String   @default("#0A66C2")
  supportEmail   String?
  supportPhone   String?
  hideSchoolBase Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  schools        School[]
}

model School {
  id                            String                   @id @default(cuid())
  partnerId                     String?
  name                          String
  slug                          String                   @unique
  initials                      String?                  @db.VarChar(12)
  paystackPublicEncrypted       String?
  paystackSecretEncrypted       String?
  twilioSidEncrypted            String?
  twilioTokenEncrypted          String?
  whatsappFromEncrypted         String?
  waCloudAccessTokenEncrypted   String?
  waCloudPhoneNumberIdEncrypted String?
  tagline                       String?
  logoUrl                       String?
  logoKey                       String?
  logoPlaceholder               String?
  principalName                 String?
  principalSignatureUrl         String?
  stampUrl                      String?
  principalComment              String?                  @db.LongText
  manualPaymentAccountName      String?
  manualPaymentAccountNumber    String?
  manualPaymentBankName         String?
  primaryColor                  String                   @default("#0A66C2")
  country                       String                   @default("NG")
  currency                      String                   @default("NGN")
  timezone                      String                   @default("Africa/Lagos")
  termCount                     Int                      @default(3)
  address                       String?
  city                          String?
  phone                         String?
  email                         String?
  websiteEnabled                Boolean                  @default(true)
  showPositions                 Boolean                  @default(false)
  admissionsCapabilityEnabled  Boolean                  @default(false)
  admissionsEnabled             Boolean                  @default(false)
  admissionsOpeningDate         DateTime?
  admissionsClosingDate         DateTime?
  admissionsIntroText           String?                  @db.LongText
  admissionsRequirements        String?                  @db.LongText
  admissionsContactInfo         String?                  @db.LongText
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  academicYears                 AcademicYear[]
  admissionApplications         AdmissionApplication[]
  schoolAdminNotifications     SchoolAdminNotification[]
  admissionApplicationEvents   AdmissionApplicationEvent[]
  admissionExportAudits        AdmissionExportAudit[]
  admissionCounters             AdmissionCounter[]
  announcements                 Announcement[]
  assessments                   Assessment[]
  assessmentComponents          AssessmentComponent[]
  assessmentTemplates           AssessmentTemplate[]
  attendance                    AttendanceRecord[]
  behaviourAssessments          BehaviourAssessment[]
  classes                       Class[]
  feeSchedules                  FeeSchedule[]
  feeScheduleItems              FeeScheduleItem[]
  paymentAccounts               PaymentAccount[]
  gradingScales                 GradingScale[]
  studentFeeAdjustments         StudentFeeAdjustment[]
  guardians                     Guardian[]
  invoices                      Invoice[]
  notifications                 Notification[]
  whatsappDeliveries            WhatsAppDelivery[]
  whatsappPolicy                WhatsAppPolicy?
  communicationRules            CommunicationRule[]
  psychomotorAssessments        PsychomotorAssessment[]
  pupils                        Pupil[]
  reportTemplates               ReportTemplate[]
  resultAudits                  ResultAudit[]
  signatories                   Signatory[]
  resultSheets                  ResultSheet[]
  studentSummaries              StudentTermSummary[]     @relation("School_StudentTermSummary")
  promotionRecords              PromotionRecord[]        @relation("School_PromotionRecord")
  historicalTermTotals          HistoricalTermTotal[]
  resultPins                    ResultPin[]
  resultPinBatches              ResultPinBatch[]
  partner                       Partner?                 @relation(fields: [partnerId], references: [id], map: "School_partnerId_fkey")
  enabledPhases                 SchoolOnPhase[]
  subjects                      Subject[]
  subjectClasses                SubjectClass[]
  teacherClasses                TeacherClass[]
  teacherSubjects               TeacherSubject[]
  users                         User[]
  supportRequests               SupportRequest[]
  platformSupportRequests       PlatformSupportRequest[]
  auditLogs                     PlatformAuditLog[]
  emailLogs                     EmailLog[]
  accountCategories             AccountCategory[]
  accountingAccounts            AccountingAccount[]
  accountingJournalEntries      AccountingJournalEntry[]
  accountingPeriods             AccountingPeriod[]
  bankStatementImports          BankStatementImport[]
  bankStatementEvents           BankStatementReconciliationEvent[]
  cashbookExportAudits          CashbookExportAudit[]
  financialTransactions         FinancialTransaction[]
  financialAuditLogs            FinancialAuditLog[]
  idCardQuotes                  IdCardQuote[]
  idCardOrders                  IdCardOrder[]
  idCardDrafts                  IdCardDraft[]
  idCardUsageAwards              IdCardUsageAward[]
  idCardIssuances                 IdCardIssuance[]
  competitionPupilAccounts        CompetitionPupilAccount[]
  competitionCategories           CompetitionCategory[]
  competitionQuestionSets         CompetitionQuestionSet[]
  competitionChallenges           CompetitionChallenge[]
  competitionAttempts             CompetitionChallengeAttempt[]
  competitionXpTransactions       CompetitionXpTransaction[]
  competitionLeaderboardSnapshots CompetitionLeaderboardSnapshot[]
  competitionTournaments          CompetitionTournament[]
  competitionTournamentSchools   CompetitionTournamentSchool[]
  competitionTournamentParticipants CompetitionTournamentParticipant[]
  competitionPrizes               CompetitionPrize[]
  competitionCertificates        CompetitionCertificate[]
  competitionAnnouncements       CompetitionAnnouncement[]
  competitionSuspiciousActivities CompetitionSuspiciousActivity[]
  competitionAuditLogs            CompetitionAuditLog[]
  competitionAnalyticsSnapshots   CompetitionAnalyticsSnapshot[]

  status                        SchoolStatus      @default(TRIAL)
  plan                          SchoolPlan        @default(FREE)
  trialEndsAt                   DateTime?
  subscriptionExpiresAt         DateTime?
  suspendedAt                   DateTime?
  onboardingStatus              String?           @default("Pending")
  onboardingProgress            Int               @default(0)
  lastSeenAt                    DateTime?
  resultAccessPinEnabled        Boolean           @default(false)
  resultAccessMode              String            @default("NONE")
  resultAccessPinType           String            @default("NONE")
  resultAccessPinValidity       String            @default("TERM")
  resultAccessAllowRegeneration Boolean           @default(false)
  timetableConfigs              TimetableConfig[]
  timetableEntries              TimetableEntry[]
  activities                    SchoolActivity[]
  scheduledActivities            ScheduledActivity[]

  @@index([partnerId], map: "School_partnerId_fkey")
}

/// Nursery / Primary / Secondary toggles (MySQL-friendly; one row per phase)
model SchoolOnPhase {
  schoolId String
  phase    SchoolPhase
  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, phase])
}

model AcademicYear {
  id                   String                @id @default(cuid())
  schoolId             String
  name                 String
  isCurrent            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  announcements        Announcement[]
  resultSheets         ResultSheet[]
  promotionRecords     PromotionRecord[]
  historicalTermTotals HistoricalTermTotal[]
  timetableConfigs     TimetableConfig[]
  competitionChallenges CompetitionChallenge[]
  competitionAttempts   CompetitionChallengeAttempt[]
  terms                Term[]

  @@unique([schoolId, name])
  @@index([schoolId], map: "AcademicYear_schoolId_fkey")
}

model Term {
  id                     String                  @id @default(cuid())
  academicYearId         String
  name                   String
  sortOrder              Int                     @default(1)
  startsOn               DateTime?
  endsOn                 DateTime?
  assessments            Assessment[]
  behaviourAssessments   BehaviourAssessment[]
  feeSchedules           FeeSchedule[]
  psychomotorAssessments PsychomotorAssessment[]
  resultSheets           ResultSheet[]
  historicalTermTotals   HistoricalTermTotal[]
  resultPins             ResultPin[]
  announcements          Announcement[]
  timetableConfigs       TimetableConfig[]
  competitionChallenges CompetitionChallenge[]
  competitionAttempts   CompetitionChallengeAttempt[]
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId], map: "Term_academicYearId_fkey")
}

model TimetableConfig {
  id             String            @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String?
  name           String
  timezone       String
  status         TimetableStatus   @default(DRAFT)
  publishedAt    DateTime?
  publishedBy    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  periods        TimetablePeriod[]
  entries        TimetableEntry[]
  scheduledActivities ScheduledActivity[]

  @@index([schoolId, academicYearId])
  @@index([termId])
}

model TimetablePeriod {
  id        String           @id @default(cuid())
  configId  String
  dayOfWeek Int
  name      String
  startsAt  String
  endsAt    String
  sortOrder Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  config    TimetableConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  entries   TimetableEntry[]
  scheduledActivities ScheduledActivity[]

  @@unique([configId, dayOfWeek, sortOrder])
  @@index([configId, dayOfWeek])
}

model TimetableEntry {
  id        String          @id @default(cuid())
  configId  String
  periodId  String
  schoolId  String
  classId   String
  subjectId String
  teacherId String
  room      String?
  notes     String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  config    TimetableConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  period    TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, configId])
  @@index([classId, periodId])
  @@index([teacherId, periodId])
  @@index([room, periodId])
}

model SchoolActivity {
  id                 String               @id @default(cuid())
  schoolId           String
  name               String
  category           String               @default("GENERAL")
  description        String?              @db.Text
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduledActivities ScheduledActivity[]

  @@index([schoolId, isActive])
}

model ScheduledActivity {
  id           String                    @id @default(cuid())
  schoolId     String
  configId     String
  periodId     String
  activityId   String
  audienceType ActivityAudience          @default(SCHOOL)
  location     String?
  notes        String?                   @db.Text
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  config       TimetableConfig           @relation(fields: [configId], references: [id], onDelete: Cascade)
  period       TimetablePeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  activity     SchoolActivity            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  classes      ScheduledActivityClass[]

  @@index([schoolId, configId])
  @@index([periodId])
  @@index([activityId])
}

model ScheduledActivityClass {
  scheduledActivityId String
  classId             String
  scheduledActivity   ScheduledActivity @relation(fields: [scheduledActivityId], references: [id], onDelete: Cascade)
  class               Class             @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([scheduledActivityId, classId])
  @@index([classId])
}

enum ActivityAudience {
  SCHOOL
  CLASSES
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ResultPinBatch {
  id          String      @id @default(cuid())
  schoolId    String
  batchName   String?
  type        String      @default("GENERIC")
  quantity    Int         @default(0)
  generatedBy String?
  generatedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pins        ResultPin[]
}

model ResultPin {
  id              String          @id @default(cuid())
  schoolId        String
  studentId       String?
  sessionId       String?
  termId          String?
  assessmentId    String?
  batchId         String?
  pinHash         String
  pinValue        String?
  type            String          @default("GENERIC")
  status          String          @default("ACTIVE")
  expiresAt       DateTime?
  assignedAt      DateTime?
  generatedBy     String?
  generatedAt     DateTime        @default(now())
  revokedBy       String?
  revokedAt       DateTime?
  lastValidatedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Pupil?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  term            Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  batch           ResultPinBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model Class {
  id                     String                  @id @default(cuid())
  schoolId               String
  name                   String
  phase                  SchoolPhase
  arm                    String?
  createdAt              DateTime                @default(now())
  attendance             AttendanceRecord[]
  behaviourAssessments   BehaviourAssessment[]
  psychomotorAssessments PsychomotorAssessment[]
  resultSheets           ResultSheet[]
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pupils                 Pupil[]
  subjectClasses         SubjectClass[]
  studentSummaries       StudentTermSummary[]
  subjectResults         SubjectResult[]
  teacherClasses         TeacherClass[]
  feeSchedules           FeeSchedule[]
  assessments            Assessment[]
  results                Result[]
  timetableEntries       TimetableEntry[]
  scheduledActivityLinks ScheduledActivityClass[]
  historicalTermTotals   HistoricalTermTotal[]
  competitionChallenges CompetitionChallenge[]
  competitionAttempts   CompetitionChallengeAttempt[]
  competitionTournamentParticipants CompetitionTournamentParticipant[]

  @@index([schoolId], map: "Class_schoolId_fkey")
}

model Pupil {
  id                     String                  @id @default(cuid())
  schoolId               String
  classId                String?
  address                String?
  firstName              String
  lastName               String
  admissionDate          DateTime?
  status                 String?
  bloodGroup             String?
  genotype               String?
  medicalNotes           String?                 @db.LongText
  previousSchool         String?
  previousClass          String?
  admissionNo            String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  photoUrl               String?
  dateOfBirth            DateTime?
  gender                 String?
  middleName             String?
  studentEmail           String?
  studentPhone           String?
  attendance             AttendanceRecord[]
  behaviourAssessments   BehaviourAssessment[]
  guardians              GuardianPupil[]
  invoices               Invoice[]
  promotionRecords       PromotionRecord[]
  psychomotorAssessments PsychomotorAssessment[]
  studentSummaries       StudentTermSummary[]
  subjectResults         SubjectResult[]
  class                  Class?                  @relation(fields: [classId], references: [id])
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results                Result[]
  historicalTermTotals   HistoricalTermTotal[]
  resultPins             ResultPin[]
  studentFeeAdjustments  StudentFeeAdjustment[]
  idCardIssuances        IdCardIssuance[]
  competitionAccount    CompetitionPupilAccount? @relation("CompetitionPupilAccountPupil")
  competitionAttempts   CompetitionChallengeAttempt[]
  competitionXpTransactions CompetitionXpTransaction[]
  competitionAchievements CompetitionPupilAchievement[]
  competitionChallengesSent CompetitionStudentChallenge[] @relation("CompetitionChallengeSender")
  competitionChallengesReceived CompetitionStudentChallenge[] @relation("CompetitionChallengeRecipient")
  competitionChallengesWon CompetitionStudentChallenge[] @relation("CompetitionChallengeWinner")
  competitionTournamentParticipants CompetitionTournamentParticipant[]
  competitionCertificates CompetitionCertificate[]
  competitionPrizes CompetitionPrize[]
  competitionSuspiciousActivities CompetitionSuspiciousActivity[]

  @@unique([schoolId, admissionNo])
  @@index([classId], map: "Pupil_classId_fkey")
  @@index([schoolId], map: "Pupil_schoolId_fkey")
}

model Guardian {
  id                 String             @id @default(cuid())
  schoolId           String
  firstName          String
  lastName           String
  phone              String
  altPhone           String?
  email              String?
  whatsapp           String?
  occupation         String?
  createdAt          DateTime           @default(now())
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pupils             GuardianPupil[]
  notifications      Notification[]
  whatsappDeliveries WhatsAppDelivery[]
  supportRequests    SupportRequest[]        @relation("SupportRequestGuardian")
  supportMessages    SupportRequestMessage[] @relation("SupportMessageGuardian")
  competitionAccounts CompetitionPupilAccount[]

  @@index([schoolId], map: "Guardian_schoolId_fkey")
}

model GuardianPupil {
  guardianId String
  pupilId    String
  relation   String   @default("Parent")
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  pupil      Pupil    @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@id([guardianId, pupilId])
  @@index([pupilId], map: "GuardianPupil_pupilId_fkey")
}

model User {
  id                String                @id @default(cuid())
  schoolId          String?
  email             String                @unique
  name              String
  role              UserRole
  passwordHash      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  teacherClasses    TeacherClass[]
  teacherSubjects   TeacherSubject[]
  platformAuditLogs PlatformAuditLog[]
  supportNotes      SupportInternalNote[] @relation("SupportNoteAuthor")
  createdSupportRequests SupportRequest[] @relation("SupportRequestCreator")
  supportMessages       SupportRequestMessage[] @relation("SupportMessageSender")
  createdTasks      SupportTeamTask[]     @relation("SupportTaskCreator")
  assignedTasks     SupportTeamTask[]     @relation("SupportTaskAssignee")
  timetableEntries  TimetableEntry[]
  passwordResets    PasswordReset[]
  school            School?               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  // Financial transactions
  createdTransactions   FinancialTransaction[] @relation("FinancialTransactionCreatedBy")
  postedTransactions    FinancialTransaction[] @relation("FinancialTransactionPostedBy")
  reversedTransactions  FinancialTransaction[] @relation("FinancialTransactionReversedBy")
  auditLogChanges       FinancialAuditLog[]
  cashbookExports       CashbookExportAudit[]
  admissionNotifications SchoolAdminNotification[]
  assignedAdmissionApplications AdmissionApplication[] @relation("AdmissionReviewer")
  admissionApplicationEvents AdmissionApplicationEvent[] @relation("AdmissionEventActor")
  admissionExportAudits AdmissionExportAudit[] @relation("AdmissionExportActor")
  competitionAccount    CompetitionPupilAccount?  @relation("CompetitionPupilAccountUser")
  competitionAccountsLinked CompetitionPupilAccount[] @relation("CompetitionPupilAccountLinkedBy")
  competitionAuditEvents CompetitionAuditLog[] @relation("CompetitionAuditActor")

  @@index([schoolId], map: "User_schoolId_fkey")
}

model CompetitionPupilAccount {
  id              String                         @id @default(cuid())
  schoolId        String
  pupilId         String                         @unique
  userId          String?                        @unique
  guardianId      String?
  linkedByUserId  String?
  status          CompetitionPupilAccountStatus  @default(ACTIVE)
  linkedAt        DateTime                       @default(now())
  revokedAt       DateTime?
  school          School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pupil           Pupil                          @relation("CompetitionPupilAccountPupil", fields: [pupilId], references: [id], onDelete: Cascade)
  user            User?                          @relation("CompetitionPupilAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  guardian         Guardian?                      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  linkedBy        User?                          @relation("CompetitionPupilAccountLinkedBy", fields: [linkedByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([guardianId])
  @@index([linkedByUserId])
}

model CompetitionCategory {
  id          String   @id @default(cuid())
  schoolId    String?
  subjectId   String?
  code        String
  name        String
  description String?  @db.Text
  countryCode String?  @db.VarChar(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questionSets CompetitionQuestionSet[]
  challenges  CompetitionChallenge[]
  examPractices CompetitionExamPractice[]
  tournaments CompetitionTournament[]

  @@unique([schoolId, code])
  @@index([subjectId])
  @@index([countryCode, isActive])
}

model CompetitionQuestionSet {
  id              String                    @id @default(cuid())
  schoolId        String?
  categoryId      String
  subjectId       String?
  name            String
  description     String?                   @db.Text
  gradeLabel      String?
  topic           String?
  locale          String                    @default("en")
  version         Int                       @default(1)
  status          CompetitionContentStatus  @default(DRAFT)
  createdByUserId String?
  reviewedByUserId String?
  reviewedAt      DateTime?
  reviewNotes     String?                   @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  school          School?                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category        CompetitionCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subject         Subject?                  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions       CompetitionQuestion[]
  challenges      CompetitionChallenge[]

  @@unique([schoolId, name, version])
  @@index([categoryId, status, gradeLabel])
  @@index([subjectId])
  @@index([status, createdAt])
}

model CompetitionQuestion {
  id               String                    @id @default(cuid())
  questionSetId    String
  type             CompetitionQuestionType
  difficulty       CompetitionDifficulty     @default(MEDIUM)
  prompt           String                    @db.LongText
  explanation      String?                   @db.LongText
  basePoints       Int                       @default(100)
  timeLimitSeconds Int?
  version          Int                       @default(1)
  status           CompetitionContentStatus  @default(DRAFT)
  createdByUserId  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  questionSet      CompetitionQuestionSet    @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  options          CompetitionQuestionOption[]
  media            CompetitionQuestionMedia[]
  attemptQuestions CompetitionAttemptQuestion[]
  submissions      CompetitionAnswerSubmission[]

  @@index([questionSetId, status, difficulty])
}

model CompetitionQuestionOption {
  id         String               @id @default(cuid())
  questionId String
  content    String               @db.LongText
  sortOrder  Int
  isCorrect  Boolean              @default(false)
  createdAt  DateTime             @default(now())
  question   CompetitionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
}

model CompetitionQuestionMedia {
  id         String               @id @default(cuid())
  questionId String
  assetUrl   String               @db.VarChar(2048)
  storageKey String?              @db.VarChar(512)
  mimeType   String               @db.VarChar(120)
  altText    String?              @db.VarChar(500)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  question   CompetitionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
}

model CompetitionScoringPolicy {
  id              String   @id @default(cuid())
  name            String
  version         Int
  policyJson      String   @db.LongText
  isActive        Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  challenges      CompetitionChallenge[]
  attempts        CompetitionChallengeAttempt[]

  @@unique([name, version])
  @@index([isActive, createdAt])
}

model CompetitionChallenge {
  id                String                     @id @default(cuid())
  schoolId          String?
  categoryId        String
  questionSetId     String
  scoringPolicyId   String
  classId           String?
  academicYearId    String?
  termId            String?
  title             String
  description       String?                    @db.Text
  gradeLabel        String?
  questionCount     Int
  durationSeconds   Int
  difficultyMixJson String?                    @db.LongText
  eligibilityJson   String?                    @db.LongText
  xpPolicyJson      String?                    @db.LongText
  attemptLimit      Int                        @default(1)
  opensAt           DateTime?
  closesAt          DateTime?
  status            CompetitionChallengeStatus @default(DRAFT)
  createdByUserId   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  school            School?                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category          CompetitionCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  questionSet       CompetitionQuestionSet     @relation(fields: [questionSetId], references: [id], onDelete: Restrict)
  scoringPolicy     CompetitionScoringPolicy   @relation(fields: [scoringPolicyId], references: [id], onDelete: Restrict)
  class             Class?                     @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear      AcademicYear?              @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
